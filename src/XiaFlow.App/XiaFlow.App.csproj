<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>XiaFlow</AssemblyName>
    <RootNamespace>XiaFlow.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\XiaFlow.ico</ApplicationIcon>
    <Description>匣流 XiaFlow — 专业文件压缩与归档管理器</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XiaFlow.Core\XiaFlow.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\XiaFlow.ico" />
    <Content Include="..\..\resources\engine\x64\**" Link="engine\x64\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\resources\licenses\**" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
