<Window x:Class="XiaFlow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="匣流 XiaFlow" Height="760" Width="1180" MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg0}"
        Icon="Assets/XiaFlow.ico">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0" CaptionHeight="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Bg1}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource Brush.AccentGradient}">
                        <TextBlock Text="匣" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="匣流 XiaFlow" FontSize="13.5" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text0}"/>
                    <Border x:Name="UpdateBanner" Visibility="Collapsed" Margin="16,0,0,0" CornerRadius="999" Padding="10,3"
                            Background="#33E5A23C" Cursor="Hand" MouseLeftButtonDown="UpdateBanner_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M19,12 A7,7 0 1 1 12,5 L12,2 M12,5 L15,8 M12,5 L9,8" Stretch="Uniform" Width="12" Height="12"
                                  Stroke="{DynamicResource Brush.Warn}" StrokeThickness="1.4" Fill="Transparent"/>
                            <TextBlock x:Name="UpdateBannerText" Text="发现新版本" FontSize="11.5" Margin="6,0,0,0"
                                       Foreground="{DynamicResource Brush.Warn}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button x:Name="BtnMin" Style="{StaticResource IconButton}" Click="BtnMin_Click" ToolTip="最小化">
                        <Path Data="M5,12 L19,12" Stroke="{DynamicResource Brush.Text1}" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnMax" Style="{StaticResource IconButton}" Click="BtnMax_Click" ToolTip="最大化/还原">
                        <Path Data="M5,5 L19,5 19,19 5,19 Z" Stroke="{DynamicResource Brush.Text1}" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform" Fill="Transparent"/>
                    </Button>
                    <Button x:Name="BtnClose" Style="{StaticResource IconButton}" Click="BtnClose_Click" ToolTip="关闭">
                        <Path Data="M5,5 L19,19 M19,5 L5,19" Stroke="{DynamicResource Brush.Text1}" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
                <Border Background="Transparent" Margin="200,0,120,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- 侧边导航 -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.SideGradient}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,0,10">
                        <RadioButton x:Name="NavHome" GroupName="nav" Style="{StaticResource NavItem}" Checked="Nav_Checked" Tag="home" IsChecked="True">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,3 L21,10 21,21 14,21 14,14 10,14 10,21 3,21 3,10 Z" Stretch="Uniform" Width="15" Height="15" Fill="{DynamicResource Brush.Text1}"/>
                                <TextBlock Text="首页" Margin="11,0,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="nav" Style="{StaticResource NavItem}" Checked="Nav_Checked" Tag="browser">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M3,5 L9,5 11,7 21,7 21,19 3,19 Z M3,9 L21,9" Stretch="Uniform" Width="15" Height="15" Stroke="{DynamicResource Brush.Text1}" StrokeThickness="1.4" Fill="Transparent"/>
                                <TextBlock Text="文件管理" Margin="11,0,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="nav" Style="{StaticResource NavItem}" Checked="Nav_Checked" Tag="compress">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,2 L12,9 M8.5,5.5 L12,9 15.5,5.5 M4,11 L20,11 20,21 4,21 Z M8,15 L16,15" Stretch="Uniform" Width="15" Height="15" Stroke="{DynamicResource Brush.Text1}" StrokeThickness="1.4" Fill="Transparent"/>
                                <TextBlock Text="快速压缩" Margin="11,0,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="nav" Style="{StaticResource NavItem}" Checked="Nav_Checked" Tag="extract">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,14 L12,21 M8.5,17.5 L12,21 15.5,17.5 M4,3 L20,3 20,12 4,12 Z M8,7 L16,7" Stretch="Uniform" Width="15" Height="15" Stroke="{DynamicResource Brush.Text1}" StrokeThickness="1.4" Fill="Transparent"/>
                                <TextBlock Text="快速解压" Margin="11,0,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="nav" Style="{StaticResource NavItem}" Checked="Nav_Checked" Tag="batch">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,3 L21,8 12,13 3,8 Z M5,11.5 L12,15.5 19,11.5 M5,15 L12,19 19,15" Stretch="Uniform" Width="15" Height="15" Stroke="{DynamicResource Brush.Text1}" StrokeThickness="1.4" Fill="Transparent"/>
                                <TextBlock Text="智能批量解压" Margin="11,0,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <Separator Background="{DynamicResource Brush.Border}" Height="1" Margin="14,10"/>
                        <RadioButton GroupName="nav" Style="{StaticResource NavItem}" Checked="Nav_Checked" Tag="backup">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,4 A8,8 0 1 1 4,12 M12,4 L8.5,7.5 M12,4 L15.5,7.5 M12,10 L12,14 15,16" Stretch="Uniform" Width="15" Height="15" Stroke="{DynamicResource Brush.Text1}" StrokeThickness="1.4" Fill="Transparent"/>
                                <TextBlock Text="自动备份" Margin="11,0,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="nav" Style="{StaticResource NavItem}" Checked="Nav_Checked" Tag="restore">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M20,12 A8,8 0 1 1 12,4 M12,4 L15.5,7.5 M12,4 L8.5,7.5 M12,10 L12,14 15,16" Stretch="Uniform" Width="15" Height="15" Stroke="{DynamicResource Brush.Text1}" StrokeThickness="1.4" Fill="Transparent"/>
                                <TextBlock Text="文件恢复" Margin="11,0,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <Separator Background="{DynamicResource Brush.Border}" Height="1" Margin="14,10"/>
                        <RadioButton GroupName="nav" Style="{StaticResource NavItem}" Checked="Nav_Checked" Tag="tasks">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M4,6 L9,6 9,11 4,11 Z M4,14 L9,14 9,19 4,19 Z M12,8 L20,8 M12,16 L20,16" Stretch="Uniform" Width="15" Height="15" Stroke="{DynamicResource Brush.Text1}" StrokeThickness="1.4" Fill="Transparent"/>
                                <TextBlock Text="任务中心" Margin="11,0,0,0"/>
                                <Border x:Name="TaskCountBadge" Background="{DynamicResource Brush.Accent}" CornerRadius="999" MinWidth="20" Height="17"
                                        Visibility="Collapsed" Margin="8,0,0,0" Padding="5,0">
                                    <TextBlock x:Name="TaskCountText" Text="0" FontSize="10.5" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="nav" Style="{StaticResource NavItem}" Checked="Nav_Checked" Tag="history">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,4 A8,8 0 1 1 4,12 L7,12 M12,4 A8,8 0 1 1 20,12 L17,12 M12,8 L12,12.5 15.5,15" Stretch="Uniform" Width="15" Height="15" Stroke="{DynamicResource Brush.Text1}" StrokeThickness="1.4" Fill="Transparent"/>
                                <TextBlock Text="历史记录" Margin="11,0,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <Separator Background="{DynamicResource Brush.Border}" Height="1" Margin="14,10"/>
                        <RadioButton GroupName="nav" Style="{StaticResource NavItem}" Checked="Nav_Checked" Tag="settings">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,8.5 A3.5,3.5 0 1 0 12,15.5 A3.5,3.5 0 1 0 12,8.5 M12,2.5 L13.2,5.2 16,4.5 17.5,7 20.2,8 19.8,10.8 21.5,12 19.8,13.2 20.2,16 17.5,17 16,19.5 13.2,18.8 12,21.5 10.8,18.8 8,19.5 6.5,17 3.8,16 4.2,13.2 2.5,12 4.2,10.8 3.8,8 6.5,7 8,4.5 10.8,5.2 Z" Stretch="Uniform" Width="15" Height="15" Stroke="{DynamicResource Brush.Text1}" StrokeThickness="1.2" Fill="Transparent"/>
                                <TextBlock Text="设置" Margin="11,0,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="nav" Style="{StaticResource NavItem}" Checked="Nav_Checked" Tag="about">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,3 A9,9 0 1 0 12,21 A9,9 0 1 0 12,3 M12,8 L12,8.01 M12,11 L12,16" Stretch="Uniform" Width="15" Height="15" Stroke="{DynamicResource Brush.Text1}" StrokeThickness="1.4" Fill="Transparent"/>
                                <TextBlock Text="关于与更新" Margin="11,0,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource Brush.Border}"/>

            <!-- 页面容器 -->
            <Grid Grid.Column="2">
                <ContentControl x:Name="PageHost" Margin="0"/>
            </Grid>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.Bg1}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource Brush.Success}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="就绪" FontSize="11.5" Margin="7,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text1}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="NotificationText" Text="通知 0" FontSize="11.5" Foreground="{DynamicResource Brush.Text1}"
                               VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="Notification_Click"/>
                    <TextBlock Text="{x:Static sysver:VersionTextLocator.Version}" FontSize="11.5" Margin="18,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text2}" xmlns:sysver="clr-namespace:XiaFlow.App.Services"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
