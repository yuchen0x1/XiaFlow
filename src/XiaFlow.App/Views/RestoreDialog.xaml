<Window x:Class="XiaFlow.App.Views.RestoreDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="恢复备份" Width="700" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Bg0}" ResizeMode="NoResize">
    <StackPanel Margin="18">
        <TextBlock Text="恢复选项" Style="{StaticResource H2}"/>
        <TextBlock x:Name="PointText" Text="" Style="{StaticResource Sub}" Margin="0,4,0,0"/>

        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <RadioButton x:Name="ModeOriginal" GroupName="rmode" Content="恢复到原位置（按备份清单映射回源路径）" IsChecked="True" Margin="0,0,20,0"/>
            <RadioButton x:Name="ModeNew" GroupName="rmode" Content="恢复到新位置"/>
        </StackPanel>
        <Grid x:Name="NewLocPanel" Margin="0,10,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="新位置" Style="{StaticResource Field}" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBox x:Name="NewLocBox" Grid.Column="1"/>
            <Button Content="浏览…" Grid.Column="2" Margin="8,0,0,0" Click="PickNew_Click"/>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="冲突处理：" Style="{StaticResource Field}" Margin="0,0,4,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="ConflictBox" MinWidth="140">
                <ComboBoxItem Content="自动重命名" Tag="AutoRename" IsSelected="True"/>
                <ComboBoxItem Content="覆盖当前文件" Tag="Overwrite"/>
                <ComboBoxItem Content="保留当前文件（跳过）" Tag="Skip"/>
            </ComboBox>
            <CheckBox x:Name="SelectiveBox" Content="只恢复选中的文件" Margin="24,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="查看将被覆盖的文件…" Click="PreviewOverwrite_Click"/>
        </StackPanel>

        <TextBlock x:Name="OverwriteHint" Text="" Style="{StaticResource Sub}" Margin="0,8,0,0" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Width="90" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="开始恢复" Width="110" Style="{StaticResource PrimaryButton}" Click="Start_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
