<Window x:Class="XiaFlow.App.Views.BackupTaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="备份任务设置" Width="640" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Bg0}" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="640">
        <StackPanel Margin="18">
            <TextBlock Text="任务名称" Style="{StaticResource Field}"/>
            <TextBox x:Name="NameBox"/>

            <TextBlock Text="源文件夹（可多个）" Style="{StaticResource Field}"/>
            <ListBox x:Name="SourceList" MaxHeight="110" Background="{DynamicResource Brush.Bg1}"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="添加文件夹" Click="AddSource_Click"/>
                <Button Content="移除选中" Margin="8,0,0,0" Click="RemoveSource_Click"/>
            </StackPanel>

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="备份保存位置" Style="{StaticResource Field}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBox x:Name="DestBox" Grid.Column="1"/>
                <Button Content="浏览…" Grid.Column="2" Margin="8,0,0,0" Click="PickDest_Click"/>
            </Grid>

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="备份格式" Style="{StaticResource Field}"/>
                    <ComboBox x:Name="FormatBox">
                        <ComboBoxItem Content="7Z（推荐）" Tag="7z"/>
                        <ComboBoxItem Content="ZIP" Tag="zip"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="压缩等级" Style="{StaticResource Field}"/>
                    <ComboBox x:Name="LevelBox">
                        <ComboBoxItem Content="极速" Tag="1"/>
                        <ComboBoxItem Content="快速" Tag="3"/>
                        <ComboBoxItem Content="标准" Tag="5" IsSelected="True"/>
                        <ComboBoxItem Content="高" Tag="7"/>
                        <ComboBoxItem Content="极限" Tag="9"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="备份策略" Style="{StaticResource Field}"/>
                    <ComboBox x:Name="StrategyBox">
                        <ComboBoxItem Content="完整备份（每次全量）" Tag="Full"/>
                        <ComboBoxItem Content="完整 + 增量（仅变化文件）" Tag="Incremental" IsSelected="True"/>
                        <ComboBoxItem Content="完整 + 差异（相对上次全量）" Tag="Differential"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="每 N 次增量后做一次全量" Style="{StaticResource Field}"/>
                    <ComboBox x:Name="FullEveryBox">
                        <ComboBoxItem Content="3"/>
                        <ComboBoxItem Content="7" IsSelected="True"/>
                        <ComboBoxItem Content="14"/>
                        <ComboBoxItem Content="30"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="备份周期" Style="{StaticResource Field}"/>
                    <ComboBox x:Name="ScheduleBox" SelectionChanged="Schedule_Changed">
                        <ComboBoxItem Content="手动" Tag="Manual"/>
                        <ComboBoxItem Content="每隔指定时间" Tag="Interval"/>
                        <ComboBoxItem Content="每天" Tag="Daily" IsSelected="True"/>
                        <ComboBoxItem Content="每周" Tag="Weekly"/>
                        <ComboBoxItem Content="每月" Tag="Monthly"/>
                        <ComboBoxItem Content="登录 Windows 时" Tag="OnLogon"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel x:Name="IntervalPanel" Orientation="Horizontal" Visibility="Collapsed" Grid.Column="1" VerticalAlignment="Bottom" Margin="14,0,0,0">
                    <TextBlock Text="间隔（分钟）：" Style="{StaticResource Field}" VerticalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBox x:Name="IntervalBox" Width="80" Text="60"/>
                </StackPanel>
            </Grid>

            <StackPanel x:Name="TimePanel" Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="执行时间：" Style="{StaticResource Field}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="TimeBox" Width="80" Text="02:00"/>
                <StackPanel x:Name="WeeklyPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="14,0,0,0">
                    <CheckBox x:Name="D1" Content="一" Margin="0,0,4,0" IsChecked="True" VerticalAlignment="Center"/>
                    <CheckBox x:Name="D2" Content="二" Margin="0,0,4,0" IsChecked="True" VerticalAlignment="Center"/>
                    <CheckBox x:Name="D3" Content="三" Margin="0,0,4,0" IsChecked="True" VerticalAlignment="Center"/>
                    <CheckBox x:Name="D4" Content="四" Margin="0,0,4,0" IsChecked="True" VerticalAlignment="Center"/>
                    <CheckBox x:Name="D5" Content="五" Margin="0,0,4,0" IsChecked="True" VerticalAlignment="Center"/>
                    <CheckBox x:Name="D6" Content="六" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="D0" Content="日" Margin="0,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="MonthlyPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="14,0,0,0">
                    <TextBlock Text="每月 " Style="{StaticResource Field}" VerticalAlignment="Center"/>
                    <TextBox x:Name="DayBox" Width="50" Text="1"/>
                    <TextBlock Text=" 日" Style="{StaticResource Field}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="保留策略（天数）" Style="{StaticResource Field}"/>
                    <ComboBox x:Name="KeepDaysBox">
                        <ComboBoxItem Content="永久保留" Tag="0" IsSelected="True"/>
                        <ComboBoxItem Content="最近 7 天" Tag="7"/>
                        <ComboBoxItem Content="最近 15 天" Tag="15"/>
                        <ComboBoxItem Content="最近 30 天" Tag="30"/>
                        <ComboBoxItem Content="最近 90 天" Tag="90"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="保留数量（0 = 不限）" Style="{StaticResource Field}"/>
                    <ComboBox x:Name="KeepCountBox">
                        <ComboBoxItem Content="不限" Tag="0" IsSelected="True"/>
                        <ComboBoxItem Content="保留最近 5 个" Tag="5"/>
                        <ComboBoxItem Content="保留最近 10 个" Tag="10"/>
                        <ComboBoxItem Content="保留最近 20 个" Tag="20"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <TextBlock Text="密码保护" Style="{StaticResource Field}"/>
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="EncBox" Content="启用加密备份" VerticalAlignment="Center"/>
                <ComboBox x:Name="PwdBox" Width="220" Margin="14,0,0,0" IsEnabled="False" SelectionChanged="Pwd_Selected"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <CheckBox x:Name="VerifyBox" Content="备份完成后自动校验完整性" IsChecked="True" Margin="0,0,20,0"/>
                <CheckBox x:Name="HashBox" Content="启用内容哈希识别变化（较慢但更准确）"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" Width="90" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button Content="保存任务" Width="110" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
