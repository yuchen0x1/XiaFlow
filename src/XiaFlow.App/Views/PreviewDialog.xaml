<Window x:Class="XiaFlow.App.Views.PreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="预览" Width="720" Height="520" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Bg0}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="FileTitle" Text="" Style="{StaticResource H2}"/>
        <Border Grid.Row="1" Margin="0,10,0,0" Background="{DynamicResource Brush.Bg1}" CornerRadius="8" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ContentText" Text="" FontFamily="Consolas" FontSize="12.5"
                           Foreground="{DynamicResource Brush.Text0}" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>
        <Image x:Name="PreviewImage" Grid.Row="1" Margin="0,10,0,0" Stretch="Uniform" Visibility="Collapsed"/>
        <Button Grid.Row="2" Content="关闭" Width="90" HorizontalAlignment="Right" Margin="0,12,0,0" Click="Close_Click"/>
    </Grid>
</Window>
