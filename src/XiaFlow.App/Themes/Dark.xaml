<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ======================= 深色主题（默认） ======================= -->
    <Color x:Key="Color.Bg0">#FF14151A</Color>
    <Color x:Key="Color.Bg1">#FF1B1D24</Color>
    <Color x:Key="Color.Bg2">#FF21242E</Color>
    <Color x:Key="Color.Bg3">#FF2A2E3A</Color>
    <Color x:Key="Color.Border">#FF2F333F</Color>
    <Color x:Key="Color.BorderStrong">#FF3C414E</Color>
    <Color x:Key="Color.Text0">#FFE8EAF2</Color>
    <Color x:Key="Color.Text1">#FF9AA3B5</Color>
    <Color x:Key="Color.Text2">#FF6B7280</Color>
    <Color x:Key="Color.Accent">#FF5B8CFF</Color>
    <Color x:Key="Color.Accent2">#FF7C6CFF</Color>
    <Color x:Key="Color.AccentSoft">#1A5B8CFF</Color>
    <Color x:Key="Color.Success">#FF3FB27F</Color>
    <Color x:Key="Color.Warn">#FFE5A23C</Color>
    <Color x:Key="Color.Danger">#FFE5566D</Color>
    <Color x:Key="Color.Shadow">#66000000</Color>

    <SolidColorBrush x:Key="Brush.Bg0" Color="{DynamicResource Color.Bg0}"/>
    <SolidColorBrush x:Key="Brush.Bg1" Color="{DynamicResource Color.Bg1}"/>
    <SolidColorBrush x:Key="Brush.Bg2" Color="{DynamicResource Color.Bg2}"/>
    <SolidColorBrush x:Key="Brush.Bg3" Color="{DynamicResource Color.Bg3}"/>
    <SolidColorBrush x:Key="Brush.Border" Color="{DynamicResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{DynamicResource Color.BorderStrong}"/>
    <SolidColorBrush x:Key="Brush.Text0" Color="{DynamicResource Color.Text0}"/>
    <SolidColorBrush x:Key="Brush.Text1" Color="{DynamicResource Color.Text1}"/>
    <SolidColorBrush x:Key="Brush.Text2" Color="{DynamicResource Color.Text2}"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.Accent2" Color="{DynamicResource Color.Accent2}"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{DynamicResource Color.AccentSoft}"/>
    <SolidColorBrush x:Key="Brush.Success" Color="{DynamicResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.Warn" Color="{DynamicResource Color.Warn}"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="{DynamicResource Color.Danger}"/>

    <!-- 渐变与画刷扩展 -->
    <LinearGradientBrush x:Key="Brush.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{DynamicResource Color.Accent}" Offset="0"/>
        <GradientStop Color="{DynamicResource Color.Accent2}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.SideGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF1E2030" Offset="0"/>
        <GradientStop Color="#FF191B22" Offset="1"/>
    </LinearGradientBrush>

    <!-- 布局度量 -->
    <CornerRadius x:Key="Radius.Card">10</CornerRadius>
    <CornerRadius x:Key="Radius.Control">7</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>
    <Thickness x:Key="Spacing.CardPadding" Left="16" Top="14" Right="16" Bottom="14"/>
    <Thickness x:Key="Spacing.PagePadding" Left="28" Top="18" Right="28" Bottom="18"/>
</ResourceDictionary>
