<UserControl x:Class="XiaFlow.App.Pages.QuickExtractPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:XiaFlow.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,18,28,20" MaxWidth="1120">
            <TextBlock Text="快速解压" Style="{StaticResource H1}"/>
            <TextBlock Text="支持 ZIP / 7Z / RAR / ISO / WIM 等格式，自动识别分卷与加密" Style="{StaticResource Sub}" Margin="0,4,0,14"/>

            <views:DropZone x:Name="ExtractZone" Hint="拖放压缩包到此处" SubHint="支持多个压缩包同时解压；分卷请拖入首卷"
                            MinHeight="120" FilesDropped="Zone_FilesDropped"/>

            <!-- 压缩包列表 -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="压缩包列表" Style="{StaticResource H2}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="选择压缩包…" Style="{StaticResource GhostButton}" Click="PickArchive_Click"/>
                            <Button Content="清空" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="ClearList_Click"/>
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="ArchiveList" MaxHeight="190" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📦" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Info}" FontSize="11.5" Margin="12,0,0,0" Foreground="{DynamicResource Brush.Text2}"/>
                                    </StackPanel>
                                    <Button Content="✕" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                                            Tag="{Binding}" Click="RemoveArchive_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- 解压设置 -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="解压设置" Style="{StaticResource H2}" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="解压位置" Style="{StaticResource Field}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="OutDirBox" Grid.Column="1"/>
                        <Button Content="浏览…" Grid.Column="2" Margin="8,0,0,0" Click="PickOutDir_Click"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <RadioButton x:Name="ModeHere" GroupName="exmode" Content="解压到指定目录" IsChecked="True" Margin="0,0,20,0"/>
                        <RadioButton x:Name="ModeFolder" GroupName="exmode" Content="每个压缩包自动创建独立文件夹" Margin="0,0,20,0"/>
                        <Button Content="刷新检测结果" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Click="Rescan_Click"/>
                    </StackPanel>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="密码（可选）" Style="{StaticResource Field}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="PwdBox" PasswordChanged="Pwd_Changed"/>
                            <TextBlock x:Name="PwdHint" Text="" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{DynamicResource Brush.Warn}"/>
                        </Grid>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="冲突处理：" Style="{StaticResource Field}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ConflictBox" MinWidth="140">
                            <ComboBoxItem Content="自动重命名" Tag="AutoRename" IsSelected="True"/>
                            <ComboBoxItem Content="覆盖已有文件" Tag="Overwrite"/>
                            <ComboBoxItem Content="跳过已存在" Tag="Skip"/>
                        </ComboBox>
                        <CheckBox x:Name="OpenDir" Content="完成后打开目录" IsChecked="True" Margin="24,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0" HorizontalAlignment="Right">
                <Button x:Name="BtnStart" Content="开始解压" Style="{StaticResource PrimaryButton}" Padding="26,9" FontSize="14" Click="Start_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
