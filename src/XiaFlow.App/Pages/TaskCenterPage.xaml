<UserControl x:Class="XiaFlow.App.Pages.TaskCenterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,18,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="任务中心" Style="{StaticResource H1}"/>
            <TextBlock Text="统一的任务调度：压缩、解压、批量解压、校验、备份与恢复 — 真实进度、速度与剩余时间" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BtnPauseAll" Content="⏸ 暂停全部" Click="PauseAll_Click"/>
            <Button Content="▶ 恢复全部" Margin="8,0,0,0" Click="ResumeAll_Click"/>
            <Button Content="✕ 取消全部" Margin="8,0,0,0" Click="CancelAll_Click"/>
            <Button Content="清理已完成" Margin="8,0,0,0" Click="ClearDone_Click"/>
            <TextBlock x:Name="ParallelHint" Text="" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="18,0,0,0"/>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <ListView x:Name="TaskList" BorderThickness="0" Background="Transparent">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="任务" Width="300">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Brush.Text2}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="类型" Width="80" DisplayMemberBinding="{Binding KindText}"/>
                        <GridViewColumn Header="状态" Width="110" DisplayMemberBinding="{Binding StatusText}"/>
                        <GridViewColumn Header="进度" Width="220">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" Height="5" IsHitTestVisible="False"
                                                     Visibility="{Binding ProgressVisibility}"/>
                                        <TextBlock Text="{Binding ProgressInfo}" FontSize="10.5" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource Brush.Text2}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="速度" Width="90" DisplayMemberBinding="{Binding SpeedText}"/>
                        <GridViewColumn Header="剩余时间" Width="80" DisplayMemberBinding="{Binding EtaText}"/>
                        <GridViewColumn Header="操作" Width="170">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="暂停" Style="{StaticResource GhostButton}" FontSize="11.5" Padding="8,3"
                                                Visibility="{Binding PauseVisibility}" Click="Pause_Click"/>
                                        <Button Content="恢复" Style="{StaticResource GhostButton}" FontSize="11.5" Padding="8,3"
                                                Visibility="{Binding ResumeVisibility}" Click="Resume_Click"/>
                                        <Button Content="取消" Style="{StaticResource GhostButton}" FontSize="11.5" Padding="8,3"
                                                Visibility="{Binding CancelVisibility}" Click="Cancel_Click"/>
                                        <Button Content="重试" Style="{StaticResource GhostButton}" FontSize="11.5" Padding="8,3"
                                                Visibility="{Binding RetryVisibility}" Click="Retry_Click"/>
                                        <Button Content="打开" Style="{StaticResource GhostButton}" FontSize="11.5" Padding="8,3"
                                                Visibility="{Binding OpenVisibility}" Click="Open_Click"/>
                                        <TextBlock Text="{Binding ErrorText}" FontSize="10.5" Foreground="{DynamicResource Brush.Danger}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="120"
                                                   Visibility="{Binding ErrorVisibility}" ToolTip="{Binding ErrorText}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </Grid>
</UserControl>
