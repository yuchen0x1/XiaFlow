<UserControl x:Class="XiaFlow.App.Pages.ArchiveBrowserPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,18,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="文件管理" Style="{StaticResource H1}"/>
            <TextBlock Text="不解压直接浏览与管理压缩包内部文件 —— 提取、添加、重命名、删除、预览与完整性测试" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnOpen" Content="打开压缩包…" Style="{StaticResource PrimaryButton}" Click="Open_Click"/>
                    <Button x:Name="BtnUp" Content="↑ 上一级" Margin="10,0,0,0" Click="Up_Click"/>
                    <Button x:Name="BtnRefresh" Content="刷新" Margin="6,0,0,0" Click="Refresh_Click"/>
                    <Button x:Name="BtnTest" Content="测试完整性" Margin="6,0,0,0" Click="Test_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Column="2">
                    <TextBox x:Name="SearchBox" Width="190" TextChanged="Search_Changed" ToolTip="搜索文件"/>
                    <Button Content="添加文件" Margin="10,0,0,0" Click="AddFile_Click"/>
                    <Button Content="添加文件夹" Margin="6,0,0,0" Click="AddFolder_Click"/>
                    <Button x:Name="BtnExtractAll" Content="全部提取…" Margin="10,0,0,0" Click="ExtractAll_Click"/>
                </StackPanel>
                <TextBlock x:Name="BreadcrumbText" Text="未打开压缩包" Grid.Column="1" Margin="20,0,20,0" VerticalAlignment="Center"
                           FontSize="12.5" Foreground="{DynamicResource Brush.Text1}" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <!-- 文件列表 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <ListView x:Name="FileList" BorderThickness="0" Background="Transparent"
                      MouseDoubleClick="FileList_DoubleClick"
                      SelectionMode="Extended" AllowDrop="True" Drop="List_Drop">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="名称" Width="380" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="类型" Width="90" DisplayMemberBinding="{Binding TypeText}"/>
                        <GridViewColumn Header="大小" Width="100" DisplayMemberBinding="{Binding SizeText}"/>
                        <GridViewColumn Header="压缩后" Width="100" DisplayMemberBinding="{Binding PackedText}"/>
                        <GridViewColumn Header="压缩率" Width="80" DisplayMemberBinding="{Binding RatioText}"/>
                        <GridViewColumn Header="修改时间" Width="140" DisplayMemberBinding="{Binding MtimeText}"/>
                        <GridViewColumn Header="加密" Width="60" DisplayMemberBinding="{Binding EncText}"/>
                    </GridView>
                </ListView.View>
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="提取选中…" Click="ExtractSelected_Click"/>
                        <MenuItem Header="预览" Click="Preview_Click"/>
                        <MenuItem Header="重命名" Click="Rename_Click"/>
                        <MenuItem Header="删除" Click="Delete_Click"/>
                        <Separator/>
                        <MenuItem Header="复制 SHA-256（需先提取）" Click="CopySha_Click"/>
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>
        </Border>

        <!-- 状态行 -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Text="提示：拖放压缩包到本页可直接打开" Style="{StaticResource Sub}"/>
            <TextBlock x:Name="StatsText" Text="" HorizontalAlignment="Right" Style="{StaticResource Sub}"/>
        </Grid>
    </Grid>
</UserControl>
