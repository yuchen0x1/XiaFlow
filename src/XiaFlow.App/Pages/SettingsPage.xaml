<UserControl x:Class="XiaFlow.App.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,18,28,20" MaxWidth="880">
            <TextBlock Text="设置中心" Style="{StaticResource H1}" Margin="0,0,0,6"/>
            <TextBlock Text="所有设置真实生效并立即保存" Style="{StaticResource Sub}" Margin="0,0,0,14"/>

            <!-- 常规 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="常规" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <CheckBox x:Name="StartWithWindows" Content="开机自动启动（最小化到托盘）" Checked="Changed" Unchecked="Changed"/>
                    <CheckBox x:Name="MinimizeToTray" Content="最小化时隐藏到系统托盘" Margin="0,6,0,0" Checked="Changed" Unchecked="Changed"/>
                    <CheckBox x:Name="CloseToTray" Content="关闭窗口时最小化到托盘" Margin="0,6,0,0" Checked="Changed" Unchecked="Changed"/>
                    <CheckBox x:Name="OpenFolderAfterDone" Content="压缩完成后自动打开所在目录" Margin="0,6,0,0" Checked="Changed" Unchecked="Changed"/>
                </StackPanel>
            </Border>

            <!-- 外观 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="外观" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="主题：" Style="{StaticResource Field}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="ThemeBox" MinWidth="170" SelectionChanged="Changed">
                            <ComboBoxItem Content="深色模式" Tag="Dark"/>
                            <ComboBoxItem Content="浅色模式" Tag="Light"/>
                            <ComboBoxItem Content="跟随系统" Tag="FollowSystem"/>
                        </ComboBox>
                        <CheckBox x:Name="EnableAnimations" Content="启用界面动画" Margin="24,0,0,0" VerticalAlignment="Center"
                                  Checked="Changed" Unchecked="Changed"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 压缩 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="压缩" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="默认格式：" Style="{StaticResource Field}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="DefaultFormatBox" MinWidth="140" SelectionChanged="Changed">
                            <ComboBoxItem Content="7Z" Tag="7z"/>
                            <ComboBoxItem Content="ZIP" Tag="zip"/>
                        </ComboBox>
                        <TextBlock Text="压缩后测试：" Style="{StaticResource Field}" VerticalAlignment="Center" Margin="24,0,10,0"/>
                        <CheckBox x:Name="TestAfterCompress" Content="自动完整性测试" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 解压 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="解压" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="默认解压目录：" Style="{StaticResource Field}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DefaultExtractDir"/>
                            <Button Content="浏览…" Grid.Column="1" Margin="8,0,0,0" Click="PickExtractDir_Click"/>
                        </Grid>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="文件冲突策略：" Style="{StaticResource Field}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="ConflictBox" MinWidth="150" SelectionChanged="Changed">
                            <ComboBoxItem Content="自动重命名" Tag="AutoRename"/>
                            <ComboBoxItem Content="覆盖" Tag="Overwrite"/>
                            <ComboBoxItem Content="跳过" Tag="Skip"/>
                        </ComboBox>
                        <CheckBox x:Name="ExtractToFolderByName" Content="默认按压缩包名创建独立文件夹" Margin="24,0,0,0" VerticalAlignment="Center"
                                  Checked="Changed" Unchecked="Changed"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 批量 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="批量与任务" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="最大并行任务数：" Style="{StaticResource Field}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="MaxParallelBox" MinWidth="70" SelectionChanged="Changed">
                            <ComboBoxItem Tag="1"><ComboBoxItem.Content>1</ComboBoxItem.Content></ComboBoxItem>
                            <ComboBoxItem Tag="2"><ComboBoxItem.Content>2</ComboBoxItem.Content></ComboBoxItem>
                            <ComboBoxItem Tag="3"><ComboBoxItem.Content>3</ComboBoxItem.Content></ComboBoxItem>
                            <ComboBoxItem Tag="4"><ComboBoxItem.Content>4</ComboBoxItem.Content></ComboBoxItem>
                        </ComboBox>
                        <CheckBox x:Name="BatchSkipProcessed" Content="批量解压默认跳过已处理过的压缩包" Margin="24,0,0,0" VerticalAlignment="Center"
                                  Checked="Changed" Unchecked="Changed"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 备份 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="备份" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="默认备份目录：" Style="{StaticResource Field}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DefaultBackupDir"/>
                            <Button Content="浏览…" Grid.Column="1" Margin="8,0,0,0" Click="PickBackupDir_Click"/>
                        </Grid>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <CheckBox x:Name="RunMissedBackup" Content="启动时补跑错过的备份" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed"/>
                        <CheckBox x:Name="NotifyOnBackupDone" Content="备份完成推送系统通知" Margin="24,0,0,0" VerticalAlignment="Center"
                                  Checked="Changed" Unchecked="Changed"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 安全 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="安全" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="解压总量上限：" Style="{StaticResource Field}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="MaxTotalGB" Width="60" TextChanged="Changed" Text="20"/>
                        <TextBlock Text="GB（压缩炸弹防护）" Style="{StaticResource Field}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <TextBlock Text="单文件上限：" Style="{StaticResource Field}" VerticalAlignment="Center" Margin="18,0,8,0"/>
                        <TextBox x:Name="MaxSingleGB" Width="60" TextChanged="Changed" Text="8"/>
                        <TextBlock Text="GB" Style="{StaticResource Field}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <TextBlock Text="文件数上限：" Style="{StaticResource Field}" VerticalAlignment="Center" Margin="18,0,8,0"/>
                        <TextBox x:Name="MaxFileCount" Width="80" TextChanged="Changed" Text="200000"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <CheckBox x:Name="WarnBeforeOverwrite" Content="覆盖文件前提醒" IsChecked="True" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed"/>
                    </StackPanel>

                    <TextBlock Text="密码库（DPAPI 加密存储，绝不明文）" Style="{StaticResource Field}" Margin="0,12,0,4"/>
                    <ListBox x:Name="VaultList" MaxHeight="110" Background="{DynamicResource Brush.Bg1}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="添加密码" Click="AddPwd_Click"/>
                        <Button Content="删除选中" Margin="8,0,0,0" Click="RemovePwd_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 系统集成 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="系统集成" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ContextMenuCompress" Content="右键菜单：压缩（添加到 XiaFlow 压缩包 / ZIP / 加密压缩）" Checked="Integration_Changed" Unchecked="Integration_Changed"/>
                    <CheckBox x:Name="ContextMenuExtract" Content="右键菜单：解压（当前目录 / 独立文件夹 / 批量队列）" Margin="0,6,0,0" Checked="Integration_Changed" Unchecked="Integration_Changed"/>
                    <CheckBox x:Name="ContextMenuOpen" Content="右键菜单：用匣流打开 / 测试完整性" Margin="0,6,0,0" Checked="Integration_Changed" Unchecked="Integration_Changed"/>
                    <TextBlock Text="提示：注册表写入用户级（HKCU），无需管理员；Win11 中位于「显示更多选项」经典菜单。" Style="{StaticResource Sub}" Margin="0,6,0,0"/>
                    <TextBlock Text="文件关联：匣流已将自身注册为压缩格式的“打开方式”候选，可在系统设置中确认默认应用。" Style="{StaticResource Sub}" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <!-- 更新 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="更新" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="AutoCheckUpdate" Content="自动检查更新" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed"/>
                        <TextBlock Text="检查频率：" Style="{StaticResource Field}" VerticalAlignment="Center" Margin="20,0,8,0"/>
                        <ComboBox x:Name="UpdateIntervalBox" MinWidth="110" SelectionChanged="Changed">
                            <ComboBoxItem Content="每 12 小时" Tag="12"/>
                            <ComboBoxItem Content="每天" Tag="24" IsSelected="True"/>
                            <ComboBoxItem Content="每周" Tag="168"/>
                        </ComboBox>
                        <TextBlock Text="通道：" Style="{StaticResource Field}" VerticalAlignment="Center" Margin="20,0,8,0"/>
                        <ComboBox x:Name="ChannelBox" MinWidth="120" SelectionChanged="Changed">
                            <ComboBoxItem Content="稳定版" Tag="stable"/>
                            <ComboBoxItem Content="测试版（Beta）" Tag="beta"/>
                        </ComboBox>
                    </StackPanel>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="更新源仓库：" Style="{StaticResource Field}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="UpdateSourceBox" TextChanged="Changed" ToolTip="第三方仓库只用于查看发布信息。"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
