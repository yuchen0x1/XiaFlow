<UserControl x:Class="XiaFlow.App.Pages.BatchExtractPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:XiaFlow.App.Views">
    <Grid Margin="28,18,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="智能批量解压中心" Style="{StaticResource H1}"/>
            <TextBlock Text="导入多个压缩包，自动识别格式 / 加密 / 分卷 / 损坏 / 重复，按规则批量解压并生成报告" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
        </StackPanel>

        <views:DropZone x:Name="BatchZone" Grid.Row="1" Hint="拖放压缩包 / 文件夹到此处" SubHint="递归扫描子文件夹；支持 ZIP、7Z、RAR 及其他支持的格式"
                        MinHeight="100" FilesDropped="Zone_FilesDropped"/>

        <!-- 任务列表 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="任务列表" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource BadgeBorder}" Margin="12,0,0,0">
                            <TextBlock x:Name="SummaryText" Text="共 0 项" FontSize="11.5" Foreground="{DynamicResource Brush.Text1}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ComboBox x:Name="FilterBox" MinWidth="130" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="全部" Tag="all" IsSelected="True"/>
                            <ComboBoxItem Content="正常" Tag="Ready"/>
                            <ComboBoxItem Content="密码保护" Tag="NeedsPassword"/>
                            <ComboBoxItem Content="分卷" Tag="Split"/>
                            <ComboBoxItem Content="损坏" Tag="Corrupt"/>
                            <ComboBoxItem Content="不支持" Tag="Unsupported"/>
                            <ComboBoxItem Content="重复" Tag="Duplicate"/>
                            <ComboBoxItem Content="执行中" Tag="Extracting"/>
                            <ComboBoxItem Content="完成" Tag="Done"/>
                            <ComboBoxItem Content="失败" Tag="Failed"/>
                        </ComboBox>
                        <Button Content="扫描文件夹…" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="ScanFolder_Click"/>
                        <Button Content="重新检测" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="Reanalyze_Click"/>
                        <Button Content="清空" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="ClearAll_Click"/>
                    </StackPanel>
                </Grid>

                <DataGrid x:Name="ItemsGrid" Grid.Row="1" IsReadOnly="True" SelectionMode="Extended" ItemsSource="{Binding FilteredView}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="文件名" Binding="{Binding DisplayName}" Width="2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="ToolTip" Value="{Binding Path}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="格式" Binding="{Binding FormatName}" Width="70"/>
                        <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="90"/>
                        <DataGridTextColumn Header="条目" Binding="{Binding FileCountText}" Width="60"/>
                        <DataGridTemplateColumn Header="状态" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{Binding StateBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding StateText}" FontSize="11.5" Margin="6,0,0,0"
                                                   Foreground="{DynamicResource Brush.Text0}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="进度" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="5" IsHitTestVisible="False"
                                                     Visibility="{Binding ProgressVisibility}"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="10.5" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource Brush.Text2}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="操作" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="解压" Style="{StaticResource GhostButton}" FontSize="11.5" Padding="8,3"
                                                Visibility="{Binding CanExtractVisibility}" Click="RowExtract_Click"/>
                                        <Button Content="密码…" Style="{StaticResource GhostButton}" FontSize="11.5" Padding="8,3"
                                                Visibility="{Binding NeedPwdVisibility}" Click="RowPassword_Click"/>
                                        <Button Content="暂停" Style="{StaticResource GhostButton}" FontSize="11.5" Padding="8,3"
                                                Visibility="{Binding PauseVisibility}" Click="RowPause_Click"/>
                                        <Button Content="恢复" Style="{StaticResource GhostButton}" FontSize="11.5" Padding="8,3"
                                                Visibility="{Binding ResumeVisibility}" Click="RowResume_Click"/>
                                        <Button Content="取消" Style="{StaticResource GhostButton}" FontSize="11.5" Padding="8,3"
                                                Visibility="{Binding CancelVisibility}" Click="RowCancel_Click"/>
                                        <Button Content="打开" Style="{StaticResource GhostButton}" FontSize="11.5" Padding="8,3"
                                                Visibility="{Binding OpenVisibility}" Click="RowOpen_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 设置与控制 -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="输出根目录" Style="{StaticResource Field}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="OutputRoot" Grid.Column="1"/>
                    <Button Content="浏览…" Grid.Column="2" Margin="8,0,0,0" Click="PickOutput_Click"/>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="输出模式：" Style="{StaticResource Field}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ModeBox" MinWidth="190" SelectionChanged="Mode_Changed">
                        <ComboBoxItem Content="A: 全部解压到指定目录" Tag="SingleDirectory"/>
                        <ComboBoxItem Content="B: 每包独立文件夹" Tag="OwnFolderEach" IsSelected="True"/>
                        <ComboBoxItem Content="C: 按归档目录结构" Tag="PreserveStructure"/>
                        <ComboBoxItem Content="D: 按文件类型分类" Tag="ByFileType"/>
                        <ComboBoxItem Content="E: 只提取指定类型" Tag="OnlyFileTypes"/>
                        <ComboBoxItem Content="F: 只提取匹配文件名" Tag="OnlyNamePattern"/>
                    </ComboBox>
                    <StackPanel x:Name="TypeFilterPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="14,0,0,0">
                        <TextBlock Text="类型（分号分隔）：" Style="{StaticResource Field}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="TypeFilterBox" Width="180" Text=".pdf;.jpg;.png;.docx"/>
                    </StackPanel>
                    <StackPanel x:Name="PatternPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="14,0,0,0">
                        <TextBlock Text="文件名模式：" Style="{StaticResource Field}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="PatternBox" Width="180" Text="*.pdf|*报告*"/>
                    </StackPanel>

                    <TextBlock Text="冲突：" Style="{StaticResource Field}" Margin="20,0,4,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ConflictBox" MinWidth="120">
                        <ComboBoxItem Content="自动重命名" Tag="AutoRename" IsSelected="True"/>
                        <ComboBoxItem Content="覆盖" Tag="Overwrite"/>
                        <ComboBoxItem Content="跳过" Tag="Skip"/>
                    </ComboBox>

                    <TextBlock Text="并行数：" Style="{StaticResource Field}" Margin="20,0,4,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ParallelBox" MinWidth="70">
                        <ComboBoxItem Content="1" Tag="1"/>
                        <ComboBoxItem Content="2" Tag="2" IsSelected="True"/>
                        <ComboBoxItem Content="3" Tag="3"/>
                        <ComboBoxItem Content="4" Tag="4"/>
                    </ComboBox>

                    <CheckBox x:Name="SkipProcessed" Content="跳过已处理过" IsChecked="True" Margin="20,0,0,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="UseVault" Content="使用密码库匹配" IsChecked="True" Margin="16,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="统一密码（可选）：" Style="{StaticResource Field}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="GlobalPwd" Width="200"/>
                        <Button Content="输入密码后开始" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="PwdStart_Click"
                                ToolTip="为等待密码的任务统一应用此密码并开始"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnStart" Content="▶ 全部开始" Style="{StaticResource PrimaryButton}" Padding="18,8" Click="StartAll_Click"/>
                        <Button Content="⏸ 暂停全部" Margin="10,0,0,0" Click="PauseAll_Click"/>
                        <Button Content="▶ 恢复全部" Margin="8,0,0,0" Click="ResumeAll_Click"/>
                        <Button Content="✕ 取消全部" Margin="8,0,0,0" Click="CancelAll_Click"/>
                        <Button Content="导出报告" Margin="8,0,0,0" Click="ExportReport_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
