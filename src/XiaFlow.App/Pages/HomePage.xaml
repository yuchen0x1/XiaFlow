<UserControl x:Class="XiaFlow.App.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:XiaFlow.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,18,28,20" MaxWidth="1120">

            <!-- 顶部欢迎横幅 -->
            <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.AccentGradient}" BorderThickness="0" Padding="26,22" Margin="0,0,0,16">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="匣流 · 让文件井井有条" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="专业文件压缩与归档管理器 — 压缩、解压、批量处理、自动备份" FontSize="13" Margin="0,6,0,0"
                                   Foreground="#DDFFFFFF"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="快速压缩" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="GoCompress_Click"/>
                        <Button Content="快速解压" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="GoExtract_Click"/>
                        <Button Content="智能批量解压" Style="{StaticResource PrimaryButton}" Click="GoBatch_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 统计卡片 -->
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="今日备份" Style="{StaticResource Sub}"/>
                        <TextBlock x:Name="StatBackupToday" Text="0" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
                        <TextBlock x:Name="StatBackupWeek" Text="本周 0 次" Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="备份总数" Style="{StaticResource Sub}"/>
                        <TextBlock x:Name="StatBackupTotal" Text="0" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
                        <TextBlock x:Name="StatBackupFailed" Text="失败 0 次" Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="备份占用空间" Style="{StaticResource Sub}"/>
                        <TextBlock x:Name="StatBackupBytes" Text="0 B" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
                        <TextBlock x:Name="StatLastBackup" Text="暂无备份" Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="任务统计" Style="{StaticResource Sub}"/>
                        <TextBlock x:Name="StatTaskDone" Text="0" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
                        <TextBlock x:Name="StatTaskSub" Text="历史任务 0 个" Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>

                <!-- 左列 -->
                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <!-- 最近处理 -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="正在执行的任务" Style="{StaticResource H2}"/>
                                <TextBlock x:Name="RunningTasksHint" Text="暂无执行中的任务" Style="{StaticResource Sub}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <ItemsControl x:Name="RunningTasksList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Brush.Bg1}" CornerRadius="8" Padding="12,9" Margin="0,3">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11.5" HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource Brush.Accent}"/>
                                                </Grid>
                                                <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Margin="0,7,0,0"/>
                                                <TextBlock Text="{Binding ProgressText}" FontSize="11" Margin="0,4,0,0"
                                                           Foreground="{DynamicResource Brush.Text2}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 最近备份历史 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="最近备份记录" Style="{StaticResource H2}"/>
                                <Button Content="自动备份中心 →" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Click="GoBackup_Click"/>
                            </Grid>
                            <ItemsControl x:Name="RecentBackups">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Brush.Bg1}" CornerRadius="8" Padding="12,8" Margin="0,3">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding TaskName}" FontSize="12.5" FontWeight="SemiBold"/>
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource Brush.Text2}" Margin="0,2,0,0">
                                                        <Run Text="{Binding TypeText, Mode=OneWay}"/> · <Run Text="{Binding Status, Mode=OneWay}"/> · <Run Text="{Binding TimeText}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SizeText}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.Text1}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 右列 -->
                <StackPanel Grid.Column="1">
                    <!-- 快捷入口 -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="功能入口" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                            <Button Content="打开压缩包浏览（文件管理）" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="GoBrowser_Click" Margin="0,2"/>
                            <Button Content="自动备份中心" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="GoBackup_Click" Margin="0,2"/>
                            <Button Content="文件恢复中心" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="GoRestore_Click" Margin="0,2"/>
                            <Button Content="任务中心" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="GoTasks_Click" Margin="0,2"/>
                            <Button Content="设置" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="GoSettings_Click" Margin="0,2"/>
                        </StackPanel>
                    </Border>

                    <!-- 软件信息 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="软件信息" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource Sub}">
                                <Run Text="匣流 XiaFlow "/><Run Text="{x:Static sysver:VersionTextLocator.Version}" xmlns:sysver="clr-namespace:XiaFlow.App.Services"/>
                            </TextBlock>
                            <TextBlock Text="匣流专业文件压缩与归档管理器" Style="{StaticResource Sub}" Margin="0,3,0,0"/>
                            <Button x:Name="BtnUpdate" Content="检查更新" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" Click="CheckUpdate_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
