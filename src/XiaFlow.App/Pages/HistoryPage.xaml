<UserControl x:Class="XiaFlow.App.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,18,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="历史记录" Style="{StaticResource H1}"/>
            <TextBlock Text="任务历史、最近打开的压缩包与批量处理记录" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Height="Auto">
            <TabItem Header="任务历史">
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,10,0,0">
                    <ListView x:Name="TaskHistoryList" BorderThickness="0" Background="Transparent">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="时间" Width="140" DisplayMemberBinding="{Binding TimeText}"/>
                                <GridViewColumn Header="类型" Width="70" DisplayMemberBinding="{Binding KindText}"/>
                                <GridViewColumn Header="任务" Width="300" DisplayMemberBinding="{Binding Title}"/>
                                <GridViewColumn Header="状态" Width="100" DisplayMemberBinding="{Binding StatusText}"/>
                                <GridViewColumn Header="数据量" Width="100" DisplayMemberBinding="{Binding SizeText}"/>
                                <GridViewColumn Header="错误" Width="220" DisplayMemberBinding="{Binding ErrorText}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </TabItem>
            <TabItem Header="最近打开的压缩包">
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,10,0,0">
                    <ListView x:Name="RecentList" BorderThickness="0" Background="Transparent" MouseDoubleClick="Recent_DoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="压缩包" Width="480" DisplayMemberBinding="{Binding Path}"/>
                                <GridViewColumn Header="打开时间" Width="150" DisplayMemberBinding="{Binding TimeText}"/>
                                <GridViewColumn Header="收藏" Width="60" DisplayMemberBinding="{Binding PinText}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="清空任务历史" Click="ClearHistory_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
