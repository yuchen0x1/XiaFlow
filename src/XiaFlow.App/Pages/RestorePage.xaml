<UserControl x:Class="XiaFlow.App.Pages.RestorePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,18,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="文件恢复中心" Style="{StaticResource H1}"/>
            <TextBlock Text="浏览历史备份点，完整或选择性恢复 —— 支持恢复到原位置与新位置，恢复前确认覆盖清单" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="备份任务：" Style="{StaticResource Field}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="TaskBox" Grid.Column="1" SelectionChanged="Task_Changed"/>
                    <Button Content="刷新" Grid.Column="2" Margin="8,0,0,0" Click="Refresh_Click"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 恢复点 -->
                    <Border Background="{DynamicResource Brush.Bg1}" CornerRadius="9" Padding="10">
                        <StackPanel>
                            <TextBlock Text="恢复点（备份链）" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                            <ListBox x:Name="PointList" MaxHeight="330" SelectionChanged="Point_Changed">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,4">
                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{DynamicResource Brush.Text2}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button x:Name="BtnRestore" Content="恢复选中备份点…" Style="{StaticResource PrimaryButton}"
                                    Margin="0,10,0,0" HorizontalAlignment="Stretch" Click="Restore_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- 内容预览 -->
                    <Border Background="{DynamicResource Brush.Bg1}" CornerRadius="9" Padding="10" Margin="14,0,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="备份内容（合并依赖链后的最新状态）" Style="{StaticResource H2}"/>
                                <Button Content="打开备份目录" HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Click="OpenDir_Click"/>
                            </Grid>
                            <ListView x:Name="EntryList" MaxHeight="360" SelectionMode="Extended">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="归档内路径" Width="360" DisplayMemberBinding="{Binding Rel}"/>
                                        <GridViewColumn Header="大小" Width="100" DisplayMemberBinding="{Binding SizeText}"/>
                                        <GridViewColumn Header="修改时间" Width="150" DisplayMemberBinding="{Binding MtimeText}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
