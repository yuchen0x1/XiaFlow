<UserControl x:Class="XiaFlow.App.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sysver="clr-namespace:XiaFlow.App.Services">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,18,28,20" MaxWidth="760">
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <Border Width="64" Height="64" CornerRadius="14" Background="{DynamicResource Brush.AccentGradient}">
                        <TextBlock Text="匣" FontSize="30" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="匣流 XiaFlow" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="匣流专业文件压缩与归档管理器" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                        <TextBlock Style="{StaticResource Sub}" Margin="0,3,0,0">
                            <Run Text="版本 "/><Run Text="{x:Static sysver:VersionTextLocator.Version}"/>
                            <Run Text=" · "/><Run x:Name="ChannelText" Text="稳定版"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 更新 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="自动更新" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnCheck" Content="检查更新" Style="{StaticResource PrimaryButton}" Padding="18,8" Click="Check_Click"/>
                        <Button x:Name="BtnDownload" Content="下载并安装更新" Style="{StaticResource PrimaryButton}" Padding="18,8"
                                Margin="10,0,0,0" Visibility="Collapsed" Click="Download_Click"/>
                        <Button x:Name="BtnSkip" Content="跳过此版本" Margin="8,0,0,0" Visibility="Collapsed" Click="Skip_Click"/>
                    </StackPanel>
                    <ProgressBar x:Name="UpdateProgress" Height="6" Margin="0,12,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="UpdateStatus" Text="" Style="{StaticResource Sub}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 更新日志 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="Collapsed" x:Name="NotesCard">
                <StackPanel>
                    <TextBlock Text="更新内容" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <TextBox x:Name="NotesBox" IsReadOnly="True" MinHeight="120" MaxHeight="260"
                             FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap" Background="{DynamicResource Brush.Bg1}"/>
                </StackPanel>
            </Border>

            <!-- 关于 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="关于" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <TextBlock Text="匣流（XiaFlow）是一款现代化的 Windows 专业压缩、解压、文件管理、批量处理与自动备份软件。" Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                    <TextBlock Text="压缩引擎基于 7-Zip (7z.exe)，以独立进程运行，UI 与引擎完全分离。" Style="{StaticResource Sub}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="打开项目主页" Style="{StaticResource GhostButton}" Click="OpenHome_Click"/>
                        <Button Content="查看开源许可" Style="{StaticResource GhostButton}" Margin="14,0,0,0" Click="OpenLicense_Click"/>
                        <Button Content="打开数据目录" Style="{StaticResource GhostButton}" Margin="14,0,0,0" Click="OpenData_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 许可声明 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="第三方组件与许可" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap">
                        · 7-Zip (7z.exe / 7z.dll)：LGPL-2.1 与 unRAR 限制（RAR 压缩创建因授权限制未提供，仅支持解压）<LineBreak/>
                        · SharpCompress：MIT<LineBreak/>
                        · K4os.Compression.LZ4：MIT<LineBreak/>
                        · H.NotifyIcon：MIT<LineBreak/>
                        · .NET (WPF)：MIT
                    </TextBlock>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="完整许可文本随程序分发于 licenses 目录。匣流不复制任何参考产品的品牌、图标或受版权保护的代码。"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
