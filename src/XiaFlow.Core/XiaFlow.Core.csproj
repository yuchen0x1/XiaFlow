<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <RootNamespace>XiaFlow.Core</RootNamespace>
    <Description>XiaFlow (匣流) core library: archive engines, task orchestration, backup, security.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="XiaFlow.Tests" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <EmbeddedResource Include="Update/public-key.txt" LogicalName="XiaFlow.UpdatePublicKey" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="Backup/**;Batch/**;Integration/**;Update/**;PasswordVault.cs" />
  </ItemGroup>

</Project>
